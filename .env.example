# Server
APP_ENV=development
PERSONAL_MODE=0
# personal/trusted/full: automatically run low-risk actions for a personal instance.
# confirm: require explicit confirmation for every action above observe level.
JARVIS_TRUST_MODE=confirm
HOST=0.0.0.0
PORT=8787
DATABASE_PATH=./data/jarvis.db

# Device authentication. Generate a long random value before deployment.
DEVICE_TOKEN=

# OpenAI-compatible LLM endpoint. Keep credentials out of source code.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.your-provider.example/v1
DEEPSEEK_MODEL=your-model-name
LLM_API_FORMAT=responses

# Optional OpenAI-compatible vision endpoint/model.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Optional ASR provider. Leave empty until configured.
ASR_PROVIDER=none
ASR_API_KEY=
ASR_APP_ID=
ASR_ACCESS_KEY=
ASR_SECRET_KEY=
ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# Server-side speech synthesis. The watch receives MP3 chunks and does not
# depend on its stripped Android TTS package.
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_API_KEY=
TTS_ENDPOINT=

# Base URL used when handing links back to the user (artifacts, uploads).
PUBLIC_BASE_URL=http://127.0.0.1:8787
