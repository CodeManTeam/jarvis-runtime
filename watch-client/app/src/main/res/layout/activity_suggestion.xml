<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_page_h"
        android:paddingEnd="@dimen/space_page_h"
        android:paddingTop="@dimen/space_page_top"
        android:paddingBottom="@dimen/space_page_bottom">

        <!-- Status bar: left=time, center=建议·尚未应用(琥珀), right=battery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/statusbar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/status_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:41"
                android:textSize="@dimen/text_md"
                android:fontFamily="monospace"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:id="@+id/header_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/suggestion_status_word"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/color_warning_text" />

            <TextView
                android:id="@+id/status_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="68%"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/color_text_tertiary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/suggestion_title"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_title" />

            <TextView
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:drawableStart="@drawable/ic_chevron_left"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:text="@string/settings_back"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- 胶囊：● 确认一次 / 不自动固化 -->
        <TextView
            android:id="@+id/suggestion_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/suggestion_pill_label"
            android:textColor="@color/color_warning_text"
            android:textSize="@dimen/text_xs"
            android:background="@drawable/bg_pill_warning"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:minHeight="20dp"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/suggestion_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/suggestion_loading"
            android:textSize="@dimen/text_meta"
            android:textColor="@color/color_text_secondary" />

        <!-- 主张：候选 content，大字 -->
        <TextView
            android:id="@+id/suggestion_claim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="—"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:lineSpacingMultiplier="1.3" />

        <!-- 依据卡：候选 content 的补充说明，无则隐藏 -->
        <LinearLayout
            android:id="@+id/suggestion_evidence_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_raised"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/suggestion_evidence_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/color_text_primary"
                android:lineSpacingMultiplier="1.3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/suggestion_evidence_line"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/suggestion_evidence_missing"
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/color_text_tertiary"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 边界说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/suggestion_boundary_notice"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/color_text_primary"
            android:lineSpacingMultiplier="1.4" />

        <!-- 按钮：忽略并留痕(左) | 仅今天应用(右,琥珀) -->
        <LinearLayout
            android:id="@+id/suggestion_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ignore_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:gravity="center"
                android:text="@string/suggestion_ignore"
                android:textSize="@dimen/text_label"
                android:textColor="@color/color_text_primary"
                android:background="@drawable/bg_pill_outline"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/apply_today_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:minHeight="44dp"
                android:gravity="center"
                android:text="@string/suggestion_apply_today"
                android:textSize="@dimen/text_label"
                android:textColor="@color/color_warning_text"
                android:background="@drawable/bg_pill_warning"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/suggestion_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="—"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/color_text_tertiary"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="14dp"
            android:background="@drawable/divider_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/suggestion_footer"
            android:textSize="@dimen/text_2xs"
            android:textColor="@color/color_text_tertiary" />

    </LinearLayout>
</ScrollView>
