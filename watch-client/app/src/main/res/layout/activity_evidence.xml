<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_page_h"
        android:paddingEnd="@dimen/space_page_h"
        android:paddingTop="@dimen/space_page_top"
        android:paddingBottom="@dimen/space_page_bottom">

        <!-- Status bar: left=time, center=state word, right=battery (WATCH_UI.md §总则·2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/statusbar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/status_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:41"
                android:textSize="@dimen/text_md"
                android:fontFamily="monospace"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:id="@+id/header_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/evidence_status_word"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/color_text_tertiary" />

            <TextView
                android:id="@+id/status_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="68%"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/color_text_tertiary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/evidence_title"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_title" />

            <TextView
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:drawableStart="@drawable/ic_chevron_left"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:text="@string/settings_back"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/evidence_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/evidence_loading"
            android:textSize="@dimen/text_meta"
            android:textColor="@color/color_text_secondary" />

        <!-- 01 结论 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/evidence_layer_01"
            android:fontFamily="monospace"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/color_text_tertiary" />

        <TextView
            android:id="@+id/evidence_conclusion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/color_text_primary"
            android:lineSpacingMultiplier="1.3" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/divider_line" />

        <!-- 02 判断与依据 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/evidence_layer_02"
            android:fontFamily="monospace"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/color_text_tertiary" />

        <TextView
            android:id="@+id/evidence_judgment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/color_text_primary"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/evidence_confidence_risk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/evidence_confidence_missing"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/color_text_tertiary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/divider_line" />

        <!-- 03 引用 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/evidence_layer_03"
            android:fontFamily="monospace"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/color_text_tertiary" />

        <LinearLayout
            android:id="@+id/evidence_refs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/divider_line" />

        <!-- 04 原始输入与门控 (default collapsed) -->
        <LinearLayout
            android:id="@+id/evidence_raw_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/evidence_layer_04"
                android:fontFamily="monospace"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/color_text_tertiary" />

            <TextView
                android:id="@+id/evidence_raw_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/evidence_raw_expand"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/evidence_raw_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="14dp"
            android:background="@drawable/divider_line" />

        <TextView
            android:id="@+id/evidence_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/evidence_footer_format"
            android:textSize="@dimen/text_2xs"
            android:textColor="@color/color_text_tertiary" />

    </LinearLayout>
</ScrollView>
