<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingBottom="112dp"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_page_h"
        android:paddingEnd="@dimen/space_page_h"
        android:paddingTop="@dimen/space_page_top"
        android:paddingBottom="@dimen/space_page_bottom">

        <!-- Status bar: left=time, center=未发送·每次确认(红), right=battery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/statusbar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/status_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:41"
                android:textSize="@dimen/text_md"
                android:fontFamily="monospace"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:id="@+id/header_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/permission_status_word"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/color_error_text" />

            <TextView
                android:id="@+id/status_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="68%"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/color_text_tertiary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/permission_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_title" />

        <!-- 胶囊：● 高风险 / 外发消息 -->
        <TextView
            android:id="@+id/permission_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/permission_pill_label"
            android:textColor="@color/color_error_text"
            android:textSize="@dimen/text_xs"
            android:background="@drawable/bg_pill_error"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:minHeight="20dp"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/permission_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/permission_loading"
            android:textSize="@dimen/text_meta"
            android:textColor="@color/color_text_secondary" />

        <!-- 草稿卡 -->
        <LinearLayout
            android:id="@+id/draft_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_raised"
            android:padding="12dp">

            <TextView
                android:id="@+id/draft_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:id="@+id/draft_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="—"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/color_text_primary"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:id="@+id/draft_attachments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="—"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/color_text_tertiary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 不可逆声明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/permission_irreversible_notice"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/color_text_primary"
            android:lineSpacingMultiplier="1.4" />

        <!-- 依据行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/permission_evidence_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:id="@+id/permission_why"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/attention_why"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/color_text_tertiary"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- 按钮：取消待发(左,安全) | 确认发送一次(右,危险) -->
    </LinearLayout>
</ScrollView>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_page_h"
    android:paddingEnd="@dimen/space_page_h"
    android:paddingTop="6dp"
    android:paddingBottom="@dimen/space_page_bottom"
    android:background="@color/color_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@drawable/divider_line" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/permission_footer"
        android:textSize="@dimen/text_2xs"
        android:textColor="@color/color_text_tertiary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:gravity="center"
            android:text="@string/permission_cancel"
            android:textSize="@dimen/text_label"
            android:textColor="@color/color_text_primary"
            android:background="@drawable/bg_pill_outline"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/confirm_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:minHeight="44dp"
            android:gravity="center"
            android:text="@string/permission_confirm"
            android:textSize="@dimen/text_label"
            android:textColor="@color/color_error_text"
            android:background="@drawable/bg_pill_danger"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
